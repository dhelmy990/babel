[Unit]
Description=Fetch and apply verified dhelmy.stream releases
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
RuntimeDirectory=dhelmy-stream
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/python3 /usr/local/lib/dhelmy-stream/release_updater.py
TimeoutStartSec=30min
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=false
