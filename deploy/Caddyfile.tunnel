# Only use with Compose ports bound to loopback and a local cloudflared connector.
# Cloudflare sets X-Forwarded-Proto to the visitor's original scheme.
http://dhelmy.stream {
	@insecure not header X-Forwarded-Proto https
	redir @insecure https://dhelmy.stream{uri} permanent
	request_body {
		max_size 64MB
	}
	reverse_proxy web:8000 {
		header_up X-Forwarded-Proto https
	}
}

:80 {
	respond 404
}
