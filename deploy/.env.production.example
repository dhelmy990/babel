# Copy to /opt/dhelmy-stream/.env.production; replace every <...> value and chmod 0600.
DJANGO_SECRET_KEY=<generate-a-long-random-secret>
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=dhelmy.stream
DB_NAME=<production_database_name>
DB_USER=<production_database_user>
DB_PASSWORD=<production_database_password>
DB_HOST=db
DB_PORT=5432
POSTGRES_DB=<same-as-DB_NAME>
POSTGRES_USER=<same-as-DB_USER>
POSTGRES_PASSWORD=<same-as-DB_PASSWORD>
GOOGLE_CLIENT_ID=<google-oauth-web-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-web-client-secret>
RESEND_API_KEY=<resend-server-api-key>
REVIEW_FROM_EMAIL=<verified-sender@dhelmy.stream>
PUBLIC_BASE_URL=https://dhelmy.stream
MEDIA_ROOT=/app/media
STUDY_IMAGE=dhelmy-stream:<pinned-release-tag>
# Normally unset; only a deliberate alternative runtime secret file uses this.
# STUDY_RUNTIME_ENV_FILE=/opt/dhelmy-stream/.env.production
# Production defaults to resend; console is only for disposable restore verification.
REVIEW_EMAIL_DELIVERY=resend
