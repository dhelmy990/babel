# Reference only. Copy to /opt/dhelmy-stream/.env.production owned root:root, mode 0600.
# Replace every REPLACE value. These dummy placeholders are UNSUITABLE for a public site.
# This file is Compose/dotenv data; do not source it into a shell or commit the filled copy.
DJANGO_SECRET_KEY='REPLACE_WITH_LONG_RANDOM_SERVER_SECRET'
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=dhelmy.stream
DB_NAME='REPLACE_WITH_PRODUCTION_DATABASE_NAME'
DB_USER='REPLACE_WITH_PRODUCTION_DATABASE_USER'
DB_PASSWORD='REPLACE_WITH_PRODUCTION_DATABASE_PASSWORD'
DB_HOST=db
DB_PORT=5432
POSTGRES_DB='REPLACE_WITH_SAME_DB_NAME'
POSTGRES_USER='REPLACE_WITH_SAME_DB_USER'
POSTGRES_PASSWORD='REPLACE_WITH_SAME_DB_PASSWORD'
GOOGLE_CLIENT_ID='REPLACE_WITH_GOOGLE_WEB_CLIENT_ID'
GOOGLE_CLIENT_SECRET='REPLACE_WITH_GOOGLE_WEB_CLIENT_SECRET'
RESEND_API_KEY='REPLACE_WITH_SERVER_RESEND_KEY'
REVIEW_FROM_EMAIL='Study notes <reviews@dhelmy.stream>'
PUBLIC_BASE_URL=https://dhelmy.stream
MEDIA_ROOT=/app/media
DJANGO_SETTINGS_MODULE=website.production_settings
STUDY_IMAGE='dhelmy-stream:REPLACE_WITH_EXACT_APPROVED_COMMIT'
# Default .env.production; set only for a deliberately different runtime secret file.
# STUDY_RUNTIME_ENV_FILE=/opt/dhelmy-stream/.env.production
# Production defaults to resend. Console is only for disposable verification/restores.
REVIEW_EMAIL_DELIVERY=resend
# STUDY_RELEASE is a commit-valued docker build argument, not a runtime secret.
