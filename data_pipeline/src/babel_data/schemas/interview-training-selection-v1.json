{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://babel.local/schemas/interview-training-selection-v1.json",
  "title": "Interview training selection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "policy_version", "seed", "dataset_commit_sha", "selections"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "policy_version": {"const": "interview-training-selection-v1"},
    "seed": {"const": "babel-interview-2016-v1"},
    "dataset_commit_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "selections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["smoke", "train", "validation", "test"],
      "properties": {
        "smoke": {"$ref": "#/$defs/smoke"},
        "train": {"$ref": "#/$defs/train"},
        "validation": {"$ref": "#/$defs/validation"},
        "test": {"$ref": "#/$defs/test"}
      }
    }
  },
  "$defs": {
    "article_key": {
      "type": "string",
      "pattern": "^enwiki:2016-10-01:[1-9][0-9]*$"
    },
    "smoke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "article_keys", "sha256"],
      "properties": {
        "count": {"const": 1000},
        "article_keys": {
          "type": "array", "minItems": 1000, "maxItems": 1000,
          "uniqueItems": true, "items": {"$ref": "#/$defs/article_key"}
        },
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "train": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "article_keys", "sha256"],
      "properties": {
        "count": {"const": 50000},
        "article_keys": {
          "type": "array", "minItems": 50000, "maxItems": 50000,
          "uniqueItems": true, "items": {"$ref": "#/$defs/article_key"}
        },
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "article_keys", "sha256"],
      "properties": {
        "count": {"const": 5000},
        "article_keys": {
          "type": "array", "minItems": 5000, "maxItems": 5000,
          "uniqueItems": true, "items": {"$ref": "#/$defs/article_key"}
        },
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "article_keys", "sha256"],
      "properties": {
        "count": {"const": 5000},
        "article_keys": {
          "type": "array", "minItems": 5000, "maxItems": 5000,
          "uniqueItems": true, "items": {"$ref": "#/$defs/article_key"}
        },
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
