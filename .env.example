DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=true
DB_NAME=study_dev
DB_USER=study_dev
DB_PASSWORD=study_dev
DB_HOST=127.0.0.1
DB_PORT=5433
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Owner review digest. Settings do not load this file automatically.
# Optional server override: console in development; disabled in production.
# REVIEW_EMAIL_DELIVERY=console
RESEND_API_KEY=
REVIEW_FROM_EMAIL='Study notes <reviews@dhelmy.stream>'
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Production uses website.production_settings and a separate .env.production.
# Both Compose --env-file and web env_file must select that explicit file.
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=dhelmy.stream
# MEDIA_ROOT=/app/media
# DB_HOST=db
# DB_PORT=5432
# POSTGRES_DB must equal DB_NAME, POSTGRES_USER must equal DB_USER,
# and POSTGRES_PASSWORD must equal DB_PASSWORD. Set all six explicitly.
# POSTGRES_DB=study
# POSTGRES_USER=study
# POSTGRES_PASSWORD=replace-with-a-unique-secret
# STUDY_IMAGE=dhelmy-stream:local
