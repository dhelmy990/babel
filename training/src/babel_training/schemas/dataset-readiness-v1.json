{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://babel.local/schemas/dataset-readiness-v1.json",
  "title": "Dataset readiness v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state",
    "schema_version",
    "teacher_dimension",
    "available_examples",
    "verified_shards",
    "source_checksums",
    "remote_verified",
    "remote_commit_sha"
  ],
  "properties": {
    "state": {"enum": ["building", "pilot_ready", "complete"]},
    "schema_version": {"const": 1},
    "teacher_dimension": {"const": 100},
    "available_examples": {"type": "integer", "minimum": 0},
    "verified_shards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "examples"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "examples": {"type": "integer", "minimum": 1}
        }
      }
    },
    "source_checksums": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "remote_verified": {"type": "boolean"},
    "remote_commit_sha": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40}$"}
  },
  "allOf": [{
    "if": {"properties": {"remote_verified": {"const": true}}},
    "then": {"properties": {"remote_commit_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}}},
    "else": {"properties": {"remote_commit_sha": {"type": "null"}}}
  }, {
    "if": {"properties": {"state": {"const": "pilot_ready"}}},
    "then": {"properties": {"available_examples": {"minimum": 1}, "verified_shards": {"minItems": 1}, "source_checksums": {"minProperties": 1}}}
  }, {
    "if": {"properties": {"state": {"const": "complete"}}},
    "then": {
      "properties": {
        "available_examples": {"minimum": 1},
        "verified_shards": {"minItems": 1},
        "source_checksums": {"minProperties": 1}
      }
    }
  }]
}
