{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://babel.local/schemas/dataset-readiness-v1.json",
  "title": "Dataset readiness v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state",
    "schema_version",
    "teacher_dimension",
    "available_examples",
    "verified_shards",
    "source_checksums"
  ],
  "properties": {
    "state": {"enum": ["building", "pilot_ready", "complete"]},
    "schema_version": {"const": 1},
    "teacher_dimension": {"const": 100},
    "available_examples": {"type": "integer", "minimum": 0},
    "verified_shards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "examples"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "examples": {"type": "integer", "minimum": 1}
        }
      }
    },
    "source_checksums": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    }
  }
}
