{
  "$id": "https://babel.local/schemas/performance/benchmark-manifest-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BenchmarkManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "benchmarkRunId",
    "endpoint",
    "requestPath",
    "requestCorpusPath",
    "requestCorpusSha256",
    "candidateUniversePath",
    "candidateUniverseSha256",
    "scheduleOffsetsNs",
    "warmupCount",
    "timeoutSeconds",
    "conditions"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "benchmarkRunId": {"type": "string", "format": "uuid"},
    "endpoint": {"type": "string", "format": "uri", "pattern": "^http://(127\\.0\\.0\\.1|localhost)(:|/)"},
    "requestPath": {"const": "/api/v1/recommendations"},
    "requestCorpusPath": {"type": "string", "minLength": 1},
    "requestCorpusSha256": {"$ref": "#/$defs/sha256"},
    "candidateUniversePath": {"type": "string", "minLength": 1},
    "candidateUniverseSha256": {"$ref": "#/$defs/sha256"},
    "scheduleOffsetsNs": {"$ref": "#/$defs/schedule"},
    "warmupCount": {"type": "integer", "minimum": 0},
    "timeoutSeconds": {"type": "number", "exclusiveMinimum": 0},
    "conditions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {"$ref": "#/$defs/servingOnly"},
        {"$ref": "#/$defs/trainingNoSync"},
        {"$ref": "#/$defs/trainingAndSync"}
      ],
      "items": false
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "schedule": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "integer", "minimum": 0}
    },
    "conditionBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "trainingEnabled",
        "syncEnabled",
        "requestCorpusSha256",
        "scheduleOffsetsNs",
        "expectedModelId",
        "expectedEmbeddingSpaceId",
        "expectedPgvectorSnapshotSha256"
      ],
      "properties": {
        "name": {"enum": ["pgvector_serving_only", "pgvector_training_no_sync", "pgvector_training_and_sync"]},
        "trainingEnabled": {"type": "boolean"},
        "syncEnabled": {"type": "boolean"},
        "requestCorpusSha256": {"$ref": "#/$defs/sha256"},
        "scheduleOffsetsNs": {"$ref": "#/$defs/schedule"},
        "expectedModelId": {"type": "string", "format": "uuid"},
        "expectedEmbeddingSpaceId": {"type": "string", "format": "uuid"},
        "expectedPgvectorSnapshotSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "servingOnly": {
      "allOf": [
        {"$ref": "#/$defs/conditionBase"},
        {"properties": {"name": {"const": "pgvector_serving_only"}, "trainingEnabled": {"const": false}, "syncEnabled": {"const": false}}}
      ]
    },
    "trainingNoSync": {
      "allOf": [
        {"$ref": "#/$defs/conditionBase"},
        {"properties": {"name": {"const": "pgvector_training_no_sync"}, "trainingEnabled": {"const": true}, "syncEnabled": {"const": false}}}
      ]
    },
    "trainingAndSync": {
      "allOf": [
        {"$ref": "#/$defs/conditionBase"},
        {"properties": {"name": {"const": "pgvector_training_and_sync"}, "trainingEnabled": {"const": true}, "syncEnabled": {"const": true}}}
      ]
    }
  }
}
