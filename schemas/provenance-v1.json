{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://babel.local/schemas/provenance-v1.json",
  "title": "Distillation provenance v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "size_bytes", "sha256", "downloaded_at"],
        "properties": {
          "url": {"type": "string", "format": "uri"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "downloaded_at": {"type": "string", "format": "date"}
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    }
  }
}
