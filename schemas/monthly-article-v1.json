{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://babel.local/schemas/monthly-article-v1.json",
  "title": "Monthly observable article v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["article_key", "period", "release_scope", "source_snapshot", "namespace", "page_id", "canonical_title", "wikidata_id", "lead_text", "article_text", "redirect_titles", "content_hash", "source_revision_id"],
  "properties": {
    "article_key": {"type": "string", "pattern": "^enwiki:[1-9][0-9]*$"},
    "period": {"type": "string", "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"},
    "release_scope": {"const": "friday_demo_fixture"},
    "source_snapshot": {"type": "string", "format": "date"},
    "namespace": {"const": 0},
    "page_id": {"type": "integer", "minimum": 1},
    "canonical_title": {"type": "string", "minLength": 1},
    "wikidata_id": {"type": ["string", "null"], "pattern": "^Q[1-9][0-9]*$"},
    "lead_text": {"type": "string", "minLength": 1},
    "article_text": {"type": "string", "minLength": 1},
    "redirect_titles": {
      "type": "array",
      "uniqueItems": true,
      "x-sorted-unique": true,
      "items": {"type": "string", "minLength": 1}
    },
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_revision_id": {"type": ["integer", "null"], "minimum": 1}
  }
}
