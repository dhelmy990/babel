{
  "$id": "https://babel.local/schemas/online/embedding-space-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "compatibilityVersion": {
      "minLength": 1,
      "title": "Compatibilityversion",
      "type": "string"
    },
    "datasetRevision": {
      "pattern": "^[a-f0-9]{40,64}$",
      "title": "Datasetrevision",
      "type": "string"
    },
    "dimension": {
      "const": 100,
      "title": "Dimension",
      "type": "integer"
    },
    "distance": {
      "const": "cosine",
      "title": "Distance",
      "type": "string"
    },
    "distilledEncoderArtifact": {
      "minLength": 1,
      "title": "Distilledencoderartifact",
      "type": "string"
    },
    "embeddingSpaceId": {
      "format": "uuid",
      "title": "Embeddingspaceid",
      "type": "string"
    },
    "schemaVersion": {
      "const": 1,
      "title": "Schemaversion",
      "type": "integer"
    }
  },
  "required": [
    "schemaVersion",
    "embeddingSpaceId",
    "dimension",
    "distance",
    "distilledEncoderArtifact",
    "datasetRevision",
    "compatibilityVersion"
  ],
  "title": "EmbeddingSpaceV1",
  "type": "object"
}
