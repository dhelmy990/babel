{
  "$id": "https://babel.local/schemas/online/recommendation-request-v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidateCount": {
      "exclusiveMinimum": 0,
      "maximum": 100,
      "title": "Candidatecount",
      "type": "integer"
    },
    "creatorId": {
      "format": "uuid",
      "title": "Creatorid",
      "type": "string"
    },
    "historyBabelIds": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Historybabelids",
      "type": "array"
    },
    "parentRequestId": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Parentrequestid"
    },
    "requestId": {
      "format": "uuid",
      "title": "Requestid",
      "type": "string"
    },
    "runId": {
      "format": "uuid",
      "title": "Runid",
      "type": "string"
    },
    "schemaVersion": {
      "const": 2,
      "title": "Schemaversion",
      "type": "integer"
    },
    "sourceArticleKey": {
      "pattern": "^enwiki:[1-9][0-9]*$",
      "title": "Sourcearticlekey",
      "type": "string"
    },
    "sourceBabelId": {
      "format": "uuid",
      "title": "Sourcebabelid",
      "type": "string"
    },
    "text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Text"
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    },
    "traversalDepth": {
      "enum": [
        0,
        1
      ],
      "title": "Traversaldepth",
      "type": "integer"
    },
    "traversalSessionId": {
      "format": "uuid",
      "title": "Traversalsessionid",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "runId",
    "creatorId",
    "sourceBabelId",
    "sourceArticleKey",
    "traversalSessionId",
    "parentRequestId",
    "traversalDepth",
    "historyBabelIds",
    "candidateCount"
  ],
  "title": "RecommendationRequestV2",
  "type": "object"
}
